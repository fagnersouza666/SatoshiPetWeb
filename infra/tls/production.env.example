# Exemplo não secreto para o ambiente de produção.
# Injete estes valores pelo orquestrador; não crie um .env versionado.
QUARKUS_PROFILE=prod

# Substitua pelo IP ou CIDR privado do proxy/ingress que acessa a API.
# Não use 0.0.0.0/0: cabeçalhos X-Forwarded de qualquer origem não são aceitos.
QUARKUS_HTTP_PROXY_TRUSTED_PROXIES=caddy
# Nome DNS acima vale para a rede do Compose. Em ingress externo, use seu IP/CIDR.
SESSION_COOKIE_SECURE=true

# Preencha os destinos públicos; credenciais são injetadas pelo secret manager.
DOMAIN=satoshi-pet.example.com
CORS_ALLOWED_ORIGINS=https://satoshi-pet.example.com
OBJECT_STORAGE_ENDPOINT=https://s3.sa-east-1.amazonaws.com
OBJECT_STORAGE_BUCKET=satoshi-pet-approved
OBJECT_STORAGE_STAGING_BUCKET=satoshi-pet-staging

# O certificado e a chave TLS são montados pelo proxy a partir do secret
# manager da plataforma. Nenhum caminho ou material criptográfico entra nesta
# configuração da aplicação.
