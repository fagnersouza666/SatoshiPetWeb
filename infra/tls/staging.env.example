# Exemplo não secreto para o ambiente staging.
# Injete estes valores pelo orquestrador; não crie um .env versionado.
QUARKUS_PROFILE=staging

# Substitua pelo IP ou CIDR privado do proxy/ingress que acessa a API.
# Não use 0.0.0.0/0: cabeçalhos X-Forwarded de qualquer origem não são aceitos.
QUARKUS_HTTP_PROXY_TRUSTED_PROXIES=10.0.0.0/8

# O certificado e a chave TLS são montados pelo proxy a partir do secret
# manager da plataforma. Nenhum caminho ou material criptográfico entra nesta
# configuração da aplicação.
