{
  "name": "satoshi-pet-web",
  "version": "1.4.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "npm run start:pwa",
    "start:pwa": "npm --prefix apps/pwa run start",
    "start:api": "node scripts/mvnw.mjs quarkus:dev",
    "build": "npm run build:pwa && npm run build:api",
    "build:pwa": "npm --prefix apps/pwa run build",
    "build:api": "node scripts/mvnw.mjs package -DskipTests",
    "test": "npm run test:versao && npm run test:infra && npm run test:csp && npm run test:ci && npm run test:pwa && npm run test:pwa:contract && npm run test:api",
    "test:versao": "node infra/scripts/versao.test.mjs",
    "test:infra": "sh infra/minio/init-buckets.test.sh",
    "test:csp": "node --test infra/scripts/csp.test.mjs",
    "test:ci": "node --test infra/scripts/ci-gates.test.mjs",
    "test:pwa": "npm --prefix apps/pwa run test -- --watch=false",
    "test:pwa:contract": "node --test infra/scripts/pwa-installation-smoke.test.mjs",
    "test:pwa:install": "node infra/scripts/pwa-installation-smoke.mjs",
    "test:api": "node scripts/mvnw.mjs test",
    "verify": "node infra/scripts/versao.mjs verificar && npm run test:pwa && node scripts/mvnw.mjs verify",
    "versao": "node infra/scripts/versao.mjs",
    "check:pwa": "node infra/scripts/check-pwa.mjs",
    "check:api": "node infra/scripts/check-api.mjs"
  }
}
