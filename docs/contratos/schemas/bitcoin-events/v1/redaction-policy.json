{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:satoshi-pet-web:contracts:bitcoin-events:v1:redaction-policy",
  "title": "Política de redaction da projeção pública dos eventos Bitcoin",
  "description": "Allowlist da projeção pública; campos privados são omitidos antes da serialização e propriedades desconhecidas são rejeitadas no resultado.",
  "policyVersion": 1,
  "projection": "public",
  "serialization": {
    "entitySerialization": "forbidden",
    "unknownFieldAction": "omit-before-serialization",
    "privateFieldAction": "omit-before-serialization",
    "validationAction": "reject-unknown-properties",
    "missingRequiredPublicFieldAction": "reject-event",
    "privateValuePlaceholder": "forbidden"
  },
  "allowedEnvelopeFields": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "payload"
  ],
  "allowedPayloadPaths": {
    "BITCOIN_TRANSACTION_OBSERVED": [
      "network",
      "address",
      "txid",
      "status",
      "source",
      "outputs",
      "outputs[].vout",
      "outputs[].address",
      "outputs[].amountSats",
      "totalReceivedSats",
      "block",
      "block.hash",
      "block.height",
      "block.confirmations"
    ],
    "BITCOIN_TRANSACTION_CONFIRMED": [
      "network",
      "address",
      "txid",
      "previousStatus",
      "status",
      "source",
      "outputs",
      "outputs[].vout",
      "outputs[].address",
      "outputs[].amountSats",
      "totalReceivedSats",
      "block",
      "block.hash",
      "block.height",
      "block.confirmations"
    ],
    "BITCOIN_TRANSACTION_REPLACED": [
      "network",
      "address",
      "replacedTxid",
      "replacementTxid",
      "replacedStatus",
      "replacementStatus",
      "conflictInputs",
      "conflictInputs[].txid",
      "conflictInputs[].vout",
      "replacedReceivedSats",
      "replacementReceivedSats"
    ],
    "BITCOIN_TRANSACTION_DROPPED": [
      "network",
      "address",
      "txid",
      "previousStatus",
      "status",
      "reason",
      "evidence",
      "evidence.kind",
      "evidence.reconciledAt",
      "evidence.tip",
      "evidence.tip.hash",
      "evidence.tip.height",
      "evidence.replacementTxid",
      "invalidatedReceivedSats"
    ],
    "BITCOIN_CHAIN_REORG": [
      "network",
      "address",
      "oldTip",
      "oldTip.hash",
      "oldTip.height",
      "newTip",
      "newTip.hash",
      "newTip.height",
      "forkHeight",
      "depth",
      "affectedTransactions",
      "affectedTransactions[].txid",
      "affectedTransactions[].previousStatus",
      "affectedTransactions[].currentStatus",
      "affectedTransactions[].previousBlock",
      "affectedTransactions[].currentBlock",
      "previousConfirmedBalanceSats",
      "currentConfirmedBalanceSats"
    ],
    "BITCOIN_BALANCE_RECONCILED": [
      "network",
      "address",
      "balanceStatus",
      "confirmedBalanceSats",
      "pendingIncomingSats",
      "pendingOutgoingSats",
      "transactionsReconciled",
      "reconciliationTip",
      "reconciliationTip.hash",
      "reconciliationTip.height"
    ]
  },
  "forbiddenFieldNames": [
    "accountId",
    "petId",
    "bindingId",
    "logicalReceiptId",
    "outboxId",
    "jobId",
    "notificationId",
    "presentationCursor",
    "email",
    "authorId",
    "exchange",
    "broker",
    "budget",
    "dcaPlan",
    "commitment",
    "reportedPurchase",
    "privateNote",
    "preciseCoordinates",
    "movementHistory",
    "prompt",
    "generationSeed",
    "recoveryCode",
    "token",
    "cookie",
    "privateKey",
    "seed",
    "xprv",
    "secret",
    "credential",
    "authorization"
  ]
}
