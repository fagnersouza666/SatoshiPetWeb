# Variáveis de ambiente — Satoshi Pet Web
#
# Copie este arquivo para .env na raiz do repositório e preencha os valores.
# O .env NÃO é versionado (.gitignore). Este arquivo de exemplo SIM.
#
# Uso rápido:
#   cp .env.example .env
#   docker compose -f infra/docker-compose.yml --profile dev up --build
#
# Nunca commitar o arquivo .env nem incluir senhas, seeds ou chaves privadas
# em qualquer arquivo versionado (PRD §17).

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=satoshi_pet
POSTGRES_USER=satoshi_pet
# ATENÇÃO: troque esta senha em produção
POSTGRES_PASSWORD=satoshi_pet_dev
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# MinIO (object storage local — substitui S3 em desenvolvimento)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
# ATENÇÃO: troque esta senha em produção
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Buckets criados automaticamente pelo serviço minio-init
# MINIO_BUCKET=pet-artwork
# MINIO_STAGING_BUCKET=pet-artwork-staging

# ---------------------------------------------------------------------------
# API Quarkus
# ---------------------------------------------------------------------------
API_PORT=8080
# URL de datasource montada pelo Compose — normalmente não precisa alterar
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/satoshi_pet

# ---------------------------------------------------------------------------
# PWA Angular (nginx, porta direta sem Caddy)
# ---------------------------------------------------------------------------
PWA_PORT=4200

# ---------------------------------------------------------------------------
# Caddy (proxy reverso com TLS local)
# ---------------------------------------------------------------------------
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Para acessar https://localhost sem aviso de certificado:
#   docker exec satoshi-caddy caddy trust

# ---------------------------------------------------------------------------
# Mailpit — servidor SMTP de desenvolvimento (profile: dev)
# Captura todos os e-mails enviados pela API. Interface em http://localhost:8025
# ---------------------------------------------------------------------------
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Configuração do mailer na API (aponta para o Mailpit)
MAIL_HOST=mailpit
MAIL_PORT=1025

# ---------------------------------------------------------------------------
# Magic link (autenticação sem senha)
# ---------------------------------------------------------------------------
# Duração ISO-8601 (ex.: PT15M = 15 minutos, PT1H = 1 hora)
MAGIC_LINK_TTL=PT15M

# ---------------------------------------------------------------------------
# Bitcoin regtest (profile: dev) — nunca usar Mainnet para testes
# Documentação: https://developer.bitcoin.org/devguide/wallets.html#regtest
# ---------------------------------------------------------------------------
BITCOIN_REGTEST_PORT=18443
BITCOIN_ZMQ_BLOCK_PORT=28332
BITCOIN_ZMQ_TX_PORT=28333
BITCOIN_RPC_USER=bitcoin
# ATENÇÃO: valor para desenvolvimento local; troque em ambientes compartilhados
BITCOIN_RPC_PASSWORD=bitcoin_dev

# ---------------------------------------------------------------------------
# Variáveis somente de produção (não utilizadas em dev)
# ---------------------------------------------------------------------------
# IMAGE_REGISTRY=ghcr.io/seu-org
# APP_VERSION=0.1.0
# DOMAIN=satoshi-pet.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=sa-east-1
# MAIL_USER=
# MAIL_PASSWORD=
